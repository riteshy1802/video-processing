# PostgreSQL connection string (Supabase pooler or direct connection)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.ldlvnnskiruklipp****:[YOUR_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_POOL_MODE=transaction

# AWS Configuration
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=transcode-video-processing

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Short-lived Presigned Expiration Settings (in seconds)
PRESIGNED_UPLOAD_EXPIRY_SECONDS=900
PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=900

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000

# CloudFront Domain
CLOUDFRONT_DOMAIN=d1mf6fapq4eytv.cloudfront.net

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Planners :
KAFKA_PLANNER_TOPIC=planner.jobs
KAFKA_PLANNER_GROUP_ID=video-planners

# FFMPEG Workers:
KAFKA_WORKER_TOPIC=transcode.jobs
KAFKA_WORKER_GROUP_ID=video-transcoders

# Finalize chunks workers :
KAFKA_FINALIZE_TOPIC=finalize.jobs
KAFKA_FINALIZE_GROUP_ID=video-rendition-finalizers

# Finalize all the renditions workers :
KAFKA_FINALIZE_VIDEO_TOPIC=finalize.video.jobs
KAFKA_FINALIZE_VIDEO_GROUP_ID=video-finalizers

# Thumbnail workers:
KAFKA_THUMBNAIL_TOPIC=thumbnail.jobs
KAFKA_THUMBNAIL_GROUP_ID=thumbnail-generators

SUPPORTED_RENDITIONS=[360, 480, 720, 1080, 1440]
DISTRIBUTED_THRESHOLD_SECONDS=600
CHUNK_DURATION_SECONDS=120
