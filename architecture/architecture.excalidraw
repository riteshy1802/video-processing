      "seed": 1128784345,
      "version": 172,
      "versionNonce": 1092451569,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789550882442,
      "link": null,
      "locked": false,
      "text": "public LinkedListNode reverse(LinkedListNode head) {\n    // base case\n    if (head == null || head.next == null) {\n        return head;\n    }\n\n    // step 1: reverse rest\n    LinkedListNode newHead = reverse(head.next);\n\n    // step 2: fix current node\n    head.next.next = head;\n\n    // step 3: break old link\n    head.next = null;\n\n    return newHead;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public LinkedListNode reverse(LinkedListNode head) {\n    // base case\n    if (head == null || head.next == null) {\n        return head;\n    }\n\n    // step 1: reverse rest\n    LinkedListNode newHead = reverse(head.next);\n\n    // step 2: fix current node\n    head.next.next = head;\n\n    // step 3: break old link\n    head.next = null;\n\n    return newHead;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
