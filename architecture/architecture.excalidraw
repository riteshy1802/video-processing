      "boundElements": [],
      "updated": 1788769943847,
      "link": null,
      "locked": false,
      "text": "row = -1;\n// this tells us in which\nrow the element can\npotentially lie",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "row = -1;\n// this tells us in which row the element can potentially lie",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "LbEkHNYQ0lnWsCEDdXP47",
      "type": "text",
      "x": 7575.913333631963,
      "y": 5491.502411666735,
      "width": 58.387542724609375,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bkr",
      "roundness": null,
      "seed": 1888279479,
      "version": 38,
      "versionNonce": 429620345,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788769965790,
      "link": null,
      "locked": false,
      "text": "Target = 3",
