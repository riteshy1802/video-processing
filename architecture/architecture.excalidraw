      "boundElements": null,
      "updated": 1789550764103,
      "created": 1789501307742,
      "link": null,
      "locked": false,
      "text": "= Worker gives FFmpeg:\nsource URL + start/end timestamps\n\nFFmpeg seeks into the media and\nperforms HTTP byte-range reads as needed.",
      "fontSize": 17.949000004051136,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "= Worker gives FFmpeg:\nsource URL + start/end timestamps\n\nFFmpeg seeks into the media and\nperforms HTTP byte-range reads as needed.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hp-MiGFXZJcwIABKrjzVY",
      "type": "text",
      "x": 12875.965496294328,
      "y": 7542.9681403108825,
      "width": 207.87299955932767,
      "height": 65,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "y3TbTXm0mZKJHqMuMI-44",
      "index": "byIQ",
      "roundness": null,
      "seed": 1580286456,
      "version": 573,
      "versionNonce": 1684488063,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789550764103,
      "created": 1789501527386,
      "link": null,
      "locked": false,
      "text": "FFmpeg understands the media\ncontainer and performs seeking;\nthe underlying HTTP access can\nuse byte-range requests.",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FFmpeg understands the media container and performs seeking; the underlying HTTP access can use byte-range requests.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
