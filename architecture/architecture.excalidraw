    {
      "id": "ej4olQwMeTrkj4MVd90JG",
      "type": "text",
      "x": 9974.537416460824,
      "y": 2300.5801839418805,
      "width": 689.219482421875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bYG",
      "roundness": null,
      "seed": 1893121103,
      "version": 806,
      "versionNonce": 1017712159,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789550839602,
      "link": null,
      "locked": false,
      "text": "public static int calcMaxArea(int[] heights){\n    Stack<List<Integer>> st = new Stack<>();\n    int maxAr = 0;\n    // Pair : [height, index]\n    for(int i=0; i<heights.length;i++){\n        int start = i;\n        int h = heights[start];\n        while(!st.isEmpty() && st.peek().get(1) > h){\n            List<Integer> p = st.pop();\n            maxAr = Math.max(maxAr, p.get(0) * (i - pop.get(1)));\n            start = i; \n        }\n        st.push(new ArrayList<>(Arrays.asList(h, start)));\n    }\n    while(!st.isEmpty()){\n        List<Integer> p = st.pop();\n        maxAr = Math.max(maxAr, p.get(0) * (heights.length - p.get(1)));\n    }\n    return maxAr;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static int calcMaxArea(int[] heights){\n    Stack<List<Integer>> st = new Stack<>();\n    int maxAr = 0;\n    // Pair : [height, index]\n    for(int i=0; i<heights.length;i++){\n        int start = i;\n        int h = heights[start];\n        while(!st.isEmpty() && st.peek().get(1) > h){\n            List<Integer> p = st.pop();\n            maxAr = Math.max(maxAr, p.get(0) * (i - pop.get(1)));\n            start = i; \n        }\n        st.push(new ArrayList<>(Arrays.asList(h, start)));\n    }\n    while(!st.isEmpty()){\n        List<Integer> p = st.pop();\n        maxAr = Math.max(maxAr, p.get(0) * (heights.length - p.get(1)));\n    }\n    return maxAr;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
