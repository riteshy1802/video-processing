    {
      "id": "1wdEtxsZ9vIqJHvhzAtG7",
      "type": "text",
      "x": 2679.882147486039,
      "y": 3428.10423179108,
      "width": 1493.4185791015625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQr",
      "roundness": null,
      "seed": 1630552810,
      "version": 796,
      "versionNonce": 1514591953,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789550860404,
      "link": null,
      "locked": false,
      "text": "We have shared volumes in which we store the changes that are made to the repo which is cloned, \nso we are not storing the complete repository, we are only storing the Changes in the shared volume, which makes it storage efficient, and also \nbecomes fail proof for the container, if any container fails, then it will use the changes from the shared volume so the system doesnt loose the changes\nmade by the Agent.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "loFU3y-vwzmjHS4MjGYOf",
      "originalText": "We have shared volumes in which we store the changes that are made to the repo which is cloned, \nso we are not storing the complete repository, we are only storing the Changes in the shared volume, which makes it storage efficient, and also \nbecomes fail proof for the container, if any container fails, then it will use the changes from the shared volume so the system doesnt loose the changes made by the Agent.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "mZRtRJSIOs1g4OfiFKHT-",
      "type": "rectangle",
      "x": 4197.880729528457,
      "y": 2774.056232308374,
      "width": 431.3623392600976,
      "height": 650.8721687060661,
