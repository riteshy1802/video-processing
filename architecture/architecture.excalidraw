      "version": 1079,
      "versionNonce": 254283263,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789550770265,
      "created": 1789548220486,
      "link": null,
      "locked": false,
      "text": "Consumers commit offset to Kafka, so if any job is partially completed,\nit is not marked as complete, and hence it will be getting the same job if\nit fails as the offset doesnt update",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consumers commit offset to Kafka, so if any job is partially completed, it is not marked as complete, and hence it will be getting the same job if it fails as the offset doesnt update",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
