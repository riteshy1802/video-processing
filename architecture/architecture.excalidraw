    {
      "id": "OfM2iIx0b7SuRSauGCmex",
      "type": "text",
      "x": 13117.982704044054,
      "y": 4983.020659176321,
      "width": 312.68353271484375,
      "height": 288.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqs",
      "roundness": null,
      "seed": 696803365,
      "version": 131,
      "versionNonce": 90510891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789214441091,
      "created": 1789214042638,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public int subarraySum(int[] nums, int k) {\n        int n = nums.length;\n        int[] prefix = new int[n+1];\n        prefix[0] = 0;\n        for(int i = 1; i <= n; i++){\n            prefix[i] = prefix[i-1] + nums[i-1];\n        }\n        HashMap<Integer, Integer> map = new HashMap<>();\n        int count = 0;\n        for(int i=0; i<=n; i++){\n            int el = prefix[i];\n            int rem = el - k;\n            if(map.containsKey(rem)){\n                count+=map.get(rem);\n            }\n            map.put(el, map.getOrDefault(el, 0) + 1);\n        }\n        return count;\n    }\n}",
      "fontSize": 11,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public int subarraySum(int[] nums, int k) {\n        int n = nums.length;\n        int[] prefix = new int[n+1];\n        prefix[0] = 0;\n        for(int i = 1; i <= n; i++){\n            prefix[i] = prefix[i-1] + nums[i-1];\n        }\n        HashMap<Integer, Integer> map = new HashMap<>();\n        int count = 0;\n        for(int i=0; i<=n; i++){\n            int el = prefix[i];\n            int rem = el - k;\n            if(map.containsKey(rem)){\n                count+=map.get(rem);\n            }\n            map.put(el, map.getOrDefault(el, 0) + 1);\n        }\n        return count;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
