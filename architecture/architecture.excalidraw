    {
      "id": "nfC_eblFroi0wvzcSjv6W",
      "type": "text",
      "x": 7457.8103175006145,
      "y": 5537.435671104744,
      "width": 339.0394287109375,
      "height": 481.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bks",
      "roundness": null,
      "seed": 1021756185,
      "version": 842,
      "versionNonce": 2081144793,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788770304424,
      "link": null,
      "locked": false,
      "text": "it is a n x m matrix;\nfirst apply a binary search using the top and bottom pointers :\n\nint top = 0;\nint bottom = n-1;\n\nwhile(top<=bottom){\n    int mid = top + (bottom-top)/2;\n    int[] arr = matrix[mid];\n    if(arr[0] <= target && target<=arr[n-1]){\n        row = mid;\n        break;\n    }else if(target < arr[low]){\n        bottom = mid - 1;\n    }else if(target > arr[high]){\n        top = mid + 1;\n    }\n}\n\n\nint left = 0;\nint right = m-1;\nint[] find = matrix[row];\nwhile(left<=right){\n    int mid = left + (right-left)/2;\n    if(find[mid]==target){\n        return true;\n    }else if(target < find[mid]){\n        right = mid - 1;\n    }else if(find[mid] > target){\n        left = mid + 1;\n    }\n}\n\nreturn -1;",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "it is a n x m matrix;\nfirst apply a binary search using the top and bottom pointers :\n\nint top = 0;\nint bottom = n-1;\n\nwhile(top<=bottom){\n    int mid = top + (bottom-top)/2;\n    int[] arr = matrix[mid];\n    if(arr[0] <= target && target<=arr[n-1]){\n        row = mid;\n        break;\n    }else if(target < arr[low]){\n        bottom = mid - 1;\n    }else if(target > arr[high]){\n        top = mid + 1;\n    }\n}\n\n\nint left = 0;\nint right = m-1;\nint[] find = matrix[row];\nwhile(left<=right){\n    int mid = left + (right-left)/2;\n    if(find[mid]==target){\n        return true;\n    }else if(target < find[mid]){\n        right = mid - 1;\n    }else if(find[mid] > target){\n        left = mid + 1;\n    }\n}\n\nreturn -1;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
