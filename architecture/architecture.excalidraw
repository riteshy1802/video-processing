    {
      "id": "v1U9ze7XhqFiQqN1j8htB",
      "type": "text",
      "x": -6111.750428959892,
      "y": 2188.8215660863525,
      "width": 514.9940795898438,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcb",
      "roundness": null,
      "seed": 1889567374,
      "version": 979,
      "versionNonce": 2056999345,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789550873664,
      "link": null,
      "locked": false,
      "text": "1. Architect Agent Diagram tool fix.\n2. Currently the Purpose and all those sections are not stored in the table\nwe have to do that\n3. Multiple Iterations.\n4. HITL one by one.\n5. QA bot with read only state access.\n6. Architect to SRS agent connector (Need to define how this will be stored)\n7. Change management for both SRS and Architect must be checked.\n8. Recursively check for the dependencies.\n\n\n\n\n1. First check if the Test is generating the diagrams correctly, add more assets.\n2. Test Architect Agent. (Refine how the db is designed for architect review once)\n3. Integrate the SSE for Architect Agent, just a static with the diagrams visualtion on the UI\n4. Visit back SRS next;\n5. \n\n",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Architect Agent Diagram tool fix.\n2. Currently the Purpose and all those sections are not stored in the table\nwe have to do that\n3. Multiple Iterations.\n4. HITL one by one.\n5. QA bot with read only state access.\n6. Architect to SRS agent connector (Need to define how this will be stored)\n7. Change management for both SRS and Architect must be checked.\n8. Recursively check for the dependencies.\n\n\n\n\n1. First check if the Test is generating the diagrams correctly, add more assets.\n2. Test Architect Agent. (Refine how the db is designed for architect review once)\n3. Integrate the SSE for Architect Agent, just a static with the diagrams visualtion on the UI\n4. Visit back SRS next;\n5. \n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
