      "isDeleted": false,
      "boundElements": [],
      "updated": 1788769361799,
      "link": null,
      "locked": false,
      "text": "int low = 0;\nint high = arr.length-1;\nwhile(l<=r){\n    int mid = low + (high-low)/2;\n    if(arr[mid]==target){\n        return mid;   \n    }else if(arr[mid-1] < arr[mid] && target < arr[mid]){\n        high = mid-1;\n    }else if(arr[mid+1] > arr[mid] && target > arr[mid]){\n        low = mid+1;\n    }\n}\nreturn -1;",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int low = 0;\nint high = arr.length-1;\nwhile(l<=r){\n    int mid = low + (high-low)/2;\n    if(arr[mid]==target){\n        return mid;   \n    }else if(arr[mid-1] < arr[mid] && target < arr[mid]){\n        high = mid-1;\n    }else if(arr[mid+1] > arr[mid] && target > arr[mid]){\n        low = mid+1;\n    }\n}\nreturn -1;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
