    {
      "id": "cOxbDMIJTOB1E6L30lwMt",
      "type": "text",
      "x": 12105.190475730236,
      "y": 6143.03294676282,
      "width": 279.1998596191406,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brV",
      "roundness": null,
      "seed": 1411207598,
      "version": 659,
      "versionNonce": 1190311304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789493830026,
      "created": 1789364581085,
      "link": null,
      "locked": false,
      "text": "currEnd = 0; i = 0; farthest = 0 + 2 = 2;\ncheck is i==currEnd ? Yes : count++ => count = 1;\nand do currEnd = farthest; => currEnd = 2;\n\ncurrEnd = 2; i = 1; farthest = 1 + 3 = max(2, 4) = 4;\ncheck is i==currEnd ? No : Skip\n\ncurrEnd = 2; i = 2; farthest = max(4, 1+1) = 4;\ncheck is i==currEnd ? Yes : count++; count = 2;\ncurrEnd = farthest => currEnd = 4;\n\ncurrEnd = 4; i = 3; farthest = max(4, 1+1) = 4;\ncheck is i==currEnd ? No : Skip\n\ncurrEnd = 4 i = 4; farthest = max(4, 4+1) = 5;\ncheck is i==currEnd ? Yes : count++ => count = 3;",
      "fontSize": 11,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "currEnd = 0; i = 0; farthest = 0 + 2 = 2;\ncheck is i==currEnd ? Yes : count++ => count = 1;\nand do currEnd = farthest; => currEnd = 2;\n\ncurrEnd = 2; i = 1; farthest = 1 + 3 = max(2, 4) = 4;\ncheck is i==currEnd ? No : Skip\n\ncurrEnd = 2; i = 2; farthest = max(4, 1+1) = 4;\ncheck is i==currEnd ? Yes : count++; count = 2;\ncurrEnd = farthest => currEnd = 4;\n\ncurrEnd = 4; i = 3; farthest = max(4, 1+1) = 4;\ncheck is i==currEnd ? No : Skip\n\ncurrEnd = 4 i = 4; farthest = max(4, 4+1) = 5;\ncheck is i==currEnd ? Yes : count++ => count = 3;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-NU6M2k3ajGCiJjzvMuuI",
