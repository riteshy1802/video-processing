      "seed": 1442482270,
      "version": 295,
      "versionNonce": 567243230,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785558101556,
      "link": null,
      "locked": false,
      "text": "0, 2   and    1, 5\n\nmax (0, 1)\nmin (2, 5)\n\n1, 2                not possible if : 2, 1 let say we have 2, 0   and 1, 1    here we will get (2, 1) so we skip it. since we dont consider it reverse\n\nres = [[1, 2]]\n\n0 < 1 : i ++ \nelse : j++;\n\n",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "0, 2   and    1, 5\n\nmax (0, 1)\nmin (2, 5)\n\n1, 2                not possible if : 2, 1 let say we have 2, 0   and 1, 1    here we will get (2, 1) so we skip it. since we dont consider it reverse\n\nres = [[1, 2]]\n\n0 < 1 : i ++ \nelse : j++;\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
