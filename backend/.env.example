# PostgreSQL connection string. Use the Supabase Transaction Pooler URL (port
# 6543) when running multiple worker processes.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# auto detects the Supabase transaction pooler above. Set explicitly when using
# another transaction pooler or when forcing a direct/local connection.
DATABASE_POOL_MODE=auto
# Used only when DATABASE_POOL_MODE resolves to direct (not transaction).
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Optional: AWS Credentials for Local Development (without AWS CLI)
# Boto3's default credential chain automatically reads these if provided.
# Leave blank or omit in Production to automatically use the EC2/ECS IAM Role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (Optional if using temporary STS tokens)

# Short-lived Presigned Expiration Settings (in seconds)
PRESIGNED_UPLOAD_EXPIRY_SECONDS=900
PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=900

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000

# CloudFront Domain (Optional for Phase 1, used in Phase 2 for HLS CDN delivery)
CLOUDFRONT_DOMAIN=

# Thumbnail generation and custom upload limits
THUMBNAIL_FFMPEG_TIMEOUT_SECONDS=60
MAX_THUMBNAIL_UPLOAD_SIZE_BYTES=5242880

# Transcode worker DB lease (seconds)
TRANSCODE_LEASE_DURATION_SECONDS=120
TRANSCODE_LEASE_HEARTBEAT_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=1
RECONCILER_INTERVAL_SECONDS=30
RECONCILER_REQUEUE_AFTER_SECONDS=300
RECONCILER_BATCH_SIZE=100
