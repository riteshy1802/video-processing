    {
      "id": "HANAeqNuwL5zgWVU_76hS",
      "type": "text",
      "x": 4223.405128301243,
      "y": 2793.0363241281448,
      "width": 385.919677734375,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "hlVUt3LhfQ2EZuMQrOoiv"
      ],
      "frameId": null,
      "index": "bQw",
      "roundness": null,
      "seed": 974795475,
      "version": 632,
      "versionNonce": 969266353,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789550860404,
      "link": null,
      "locked": false,
      "text": "Expectation : \n\nWe manage all the list of basest images\non docker hub in a folder base/\n\nthis folder will consist of all the base\nimages, by versions, the one which is \nlatest will be taged as latest\n\nwhile the images which are derived from\nbase for a specific stack will be \nstored in the hub as :\n\n/nextjs_django\n/nextjs_fastapi\n/node.js\n/next.js\n/MERN\n/PERN\n\neach of the folder will store the \ndifferent version of the images\n\nVERSIONING IS IMPORTANT",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expectation : \n\nWe manage all the list of basest images\non docker hub in a folder base/\n\nthis folder will consist of all the base\nimages, by versions, the one which is \nlatest will be taged as latest\n\nwhile the images which are derived from\nbase for a specific stack will be \nstored in the hub as :\n\n/nextjs_django\n/nextjs_fastapi\n/node.js\n/next.js\n/MERN\n/PERN\n\neach of the folder will store the \ndifferent version of the images\n\nVERSIONING IS IMPORTANT",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
